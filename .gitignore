# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …pero la plantilla SÍ se versiona (solo placeholders, sin secretos)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imágenes originales 2K (pristinos, ~500MB — no van al repo)
/public/lineas-orig/

# carpeta de staging de imágenes nuevas
/public/lineas-nuevas/

# imágenes desplegadas pero SIN usar — originales/leftovers fuera del deploy.
# Se conservan en disco local; se sacaron del repo para aligerar el build (~224MB).
# (los logos servidos viven en /public/brands/v2-clean/ y SÍ se versionan)
/public/products/
/public/brands/v2/
/public/brands/*.png
/public/hero-pc.png
/public/Sitio Web.png
/public/Opciones de Logo Calro y Oscuro.png
/public/logo-oscuro.png
/public/Logo Oscuro Sin Slogan.png
/public/Logo Claro Con Slogan.png
/public/Logo Claro Sin Slogan.png

# archivos temporales de proveedores
data/suppliers/_tmp_download.pdf

# ajustes del panel admin — contiene la clave API de Anthropic (secreto)
data/settings.json

# usuarios del panel admin — contienen hashes de contraseñas (secreto)
data/admin-users.json

# backups automáticos de datos (.bak)
data/*.bak
