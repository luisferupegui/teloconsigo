# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/teloconsigo

# Auth
NEXTAUTH_SECRET=tu-secreto-aqui
NEXTAUTH_URL=http://localhost:3000

# Panel admin — usuario inicial de /admin. Solo se usa para SEMBRAR el primer
# usuario en data/admin-users.json la primera vez. Después puedes crear, borrar y
# cambiar contraseñas desde /admin/usuarios. (NO uses estos valores en producción)
ADMIN_USER=
ADMIN_PASSWORD=

# DeepSeek — cerebro del asesor "Andrea" (platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=tu-api-key-deepseek
# Opcional: endpoint alterno compatible con OpenAI (por defecto https://api.deepseek.com)
# DEEPSEEK_BASE_URL=

# Serper (serper.dev) — búsqueda web de productos. DeepSeek no navega la web:
# sin esta key Andrea no puede cotizar productos fuera de las listas de proveedor.
SERPER_API_KEY=

# Pagos (ePayco)
EPAYCO_P_CUST_ID=
EPAYCO_P_KEY=
EPAYCO_PUBLIC_KEY=
EPAYCO_TEST=true
